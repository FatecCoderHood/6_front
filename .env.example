# Switch between in-memory mocks and the real backend.
# Copy this file to .env.local (git-ignored) and adjust. Do not put secrets here.

# true  = use in-memory mocks (no backend needed)
# false = call the real backend (default when unset)
VITE_USE_MOCKS=false

# Backend base URL. Default '/api' goes through the Vite dev proxy.
# VITE_API_BASE_URL=/api

# Target of the Vite dev proxy (default http://localhost:8080).
# VITE_API_PROXY=http://localhost:8080
